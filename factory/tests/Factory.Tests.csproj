<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <ReqnrollUseIntermediateOutputPathForCodeBehindMsBuild>true</ReqnrollUseIntermediateOutputPathForCodeBehindMsBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="nunit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Doubles/**/*.cs" />
    <ProjectReference Include="../src/Factory.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Doubles/AgentDouble.csproj" ReferenceOutputAssembly="false" />
    <ReqnrollFeatureFile Include="../spec/features/*.feature" Link="Features/%(Filename)%(Extension)" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Reqnroll" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
